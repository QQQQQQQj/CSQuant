# ===== CSQuant 环境配置模板（复制为 .env 并填入真实值；.env 绝不提交 Git）=====

# --- 数据源密钥 ---
# CSQAQ ApiToken：csqaq.com 注册后点击用户头像获取（需绑定IP白名单）
CSQAQ_API_TOKEN=
# SteamDT API Key：steamdt.com 个人中心 -> API管理 申请
STEAMDT_API_KEY=

# --- Steam ---
# 自己的 Steam 64 位 ID（库存同步用；库存需公开）
STEAM_ID_64=
# 可选：浏览器登录 steamcommunity 后的 steamLoginSecure Cookie（仅 pricehistory/私有库存用，建议专用小号）
STEAM_LOGIN_SECURE=

# --- 网络代理（可选，访问 steamcommunity.com 用）---
# Watt Toolkit（Steam++）用户：开着加速即可，此处留空
# Clash/V2Ray 类代理用户：填本地代理端口，例如 http://127.0.0.1:7890
HTTPS_PROXY=
HTTP_PROXY=

# --- QQ 告警（可选；需本地 NapCat/Lagrange OneBot HTTP，用小号）---
QQ_BOT_HTTP=http://127.0.0.1:3000
QQ_BOT_TOKEN=
QQ_GROUP_ID=

# --- 双 QQ 机器人（各用小号；两通道严格隔离）---
# 库存播报机器人（不配则回退上面的 QQ_BOT_*）
INVENTORY_QQ_BOT_HTTP=http://127.0.0.1:3000
INVENTORY_QQ_BOT_TOKEN=
INVENTORY_QQ_GROUP_ID=
# 全市场异动播报机器人（不配则不启用；绝不回退到库存群，防串群）
MARKET_QQ_BOT_HTTP=http://127.0.0.1:3001
MARKET_QQ_BOT_TOKEN=
MARKET_QQ_GROUP_ID=

# --- 本地 ---
# SQLite 数据库路径（留空默认 <项目根>/data/csquant.db）
DB_PATH=
# 日志级别 DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO
# 本地 HTTP API 令牌（V2+ FastAPI 用，自生成随机串）
LOCAL_API_TOKEN=
